{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["acode-plugin-types", "node"],
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": true,
    "skipLibCheck": true
  },
  "exclude": ["./dist/**/*", "./testing/**/*"],
}
